{
  "name": "webcrypto-ratchet",
  "version": "0.7.3",
  "description": "PQXDH-style key agreement + Hybrid Double Ratchet (X25519 + ML-KEM-768 at every ratchet step) session encryption, built on the standard WebCrypto API plus @noble/post-quantum for the ML-KEM steps WebCrypto doesn't yet support.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "c8 --check-coverage --100 --reporter=text --reporter=html node --test"
  },
  "keywords": [
    "double-ratchet",
    "triple-ratchet",
    "pqxdh",
    "x3dh",
    "ml-kem",
    "post-quantum",
    "e2ee",
    "webcrypto",
    "signal-protocol"
  ],
  "dependencies": {
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
